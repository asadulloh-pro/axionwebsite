---
import Layout from '../layouts/Layout.astro';
import ContactForm from './ContactForm';
import { getDictionary, type Locale } from '../i18n';
import { localizePath } from '../lib/paths';

interface Props {
  locale?: Locale;
}

const locale = (Astro.props.locale ?? 'uz') as Locale;
const dict = getDictionary(locale);
const page = dict.contactPage;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: dict.nav.home,
      item: `https://axionlab.uz${localizePath('', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: dict.nav.contact,
      item: `https://axionlab.uz${localizePath('contact', locale)}`,
    },
  ],
};

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: page.metaTitle,
  description: page.metaDescription,
  url: `https://axionlab.uz${localizePath('contact', locale)}`,
};
---

<Layout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={localizePath('contact', locale)}
  jsonLd={[breadcrumb, contactLd]}
>
  <section class="page-hero contact">
    <div class="container-axion contact__grid">
      <div class="contact__info">
        <p class="kicker reveal">
          <span class="kicker__idx">{page.label.replace(/[\[\]]/g, '')}</span>
          <span class="kicker__rule" aria-hidden="true"></span>
          <span>Axionlab</span>
        </p>
        <h1 class="headline page-hero__title reveal" style="transition-delay: 80ms">{page.title}</h1>
        <p class="lede page-hero__lede reveal" style="transition-delay: 160ms">{page.subtitle}</p>

        <dl class="contact__details reveal" style="transition-delay: 220ms">
          <div>
            <dt class="label-mono">{page.officeTitle}</dt>
            <dd>{page.officeAddress}</dd>
          </div>
          <div>
            <dt class="label-mono">{page.salesTitle}</dt>
            <dd><a href={`mailto:${page.email}`} class="contact__email">{page.email}</a></dd>
          </div>
        </dl>

        <div class="contact__map panel reveal" style="transition-delay: 260ms">
          <iframe
            title="Axionlab office map"
            src="https://www.openstreetmap.org/export/embed.html?bbox=69.240%2C41.295%2C69.270%2C41.315&layer=mapnik&marker=41.305%2C69.255"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <p class="contact__attrib">
          <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">© OpenStreetMap</a>
        </p>
      </div>

      <div class="contact__form panel reveal" style="transition-delay: 120ms">
        <ContactForm
          client:load
          fields={page.form.fields}
          submitLabel={page.form.submit}
          submittingLabel={page.form.submitting}
          successMessage={page.form.success}
          errorMessage={page.form.error}
          locale={locale}
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact {
    border-bottom: 0;
  }

  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }

  .contact__details {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0 0;
  }

  .contact__details dt {
    margin-bottom: 0.4rem;
  }

  .contact__details dd {
    margin: 0;
    color: var(--color-fg-muted);
  }

  .contact__email {
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-border-strong);
    transition: border-color 0.4s ease;
  }

  .contact__email:hover {
    border-color: var(--color-accent);
  }

  .contact__map {
    margin-top: 2.5rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .contact__map iframe {
    display: block;
    width: 100%;
    height: calc(100% + 5rem);
    margin-bottom: -5rem;
    border: 0;
    filter: grayscale(1) invert(0.92) contrast(1.1);
    opacity: 0.85;
  }

  .contact__attrib {
    margin: 0.65rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--color-fg-dim);
  }

  .contact__attrib a {
    color: inherit;
  }

  .contact__attrib a:hover {
    color: var(--color-fg-muted);
  }

  .contact__form {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-bg-elevated);
  }
</style>
