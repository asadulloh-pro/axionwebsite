---
import type { Dictionary, Locale } from '../i18n/types';
import { localizePath } from '../lib/paths';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const year = new Date().getFullYear();

const links = [
  { label: dict.nav.home, href: localizePath('', locale) },
  { label: dict.nav.about, href: localizePath('about', locale) },
  { label: dict.nav.solutions, href: localizePath('solutions', locale) },
  { label: dict.nav.technologies, href: localizePath('technologies', locale) },
  { label: dict.nav.contact, href: localizePath('contact', locale) },
];
---

<footer class="footer">
  <div class="container-axion">
    <div class="footer__top">
      <div class="footer__brand">
        <a href={localizePath('', locale)} aria-label="Axionlab">
          <img src="/icons/logo.svg" alt="Axionlab" width="140" height="30" class="footer__logo" />
        </a>
        <p class="footer__tagline">{dict.footer.tagline}</p>
      </div>

      <div class="footer__cols">
        <div>
          <p class="label-mono footer__label">{dict.footer.links}</p>
          <ul class="footer__list">
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="label-mono footer__label">{dict.footer.contact}</p>
          <ul class="footer__list">
            <li>
              <a href={`mailto:${dict.contactPage.email}`}>{dict.contactPage.email}</a>
            </li>
            <li class="footer__muted">{dict.contactPage.officeAddress}</li>
          </ul>
        </div>
      </div>
    </div>

    <p class="footer__mark" aria-hidden="true">Axionlab</p>

    <div class="footer__bottom">
      <p>© {year} Axionlab. {dict.footer.rights}</p>
      <p>axionlab.uz</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    padding-block: clamp(3.5rem, 7vw, 5rem) 2rem;
  }

  .footer__top {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .footer__logo {
    height: 1.6rem;
    width: auto;
  }

  .footer__tagline {
    margin-top: 1.25rem;
    max-width: 26rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-fg-muted);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer__label {
    margin-bottom: 1rem;
  }

  .footer__list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
  }

  .footer__list a {
    color: var(--color-fg-muted);
    transition: color 0.2s ease;
  }

  .footer__list a:hover {
    color: var(--color-fg);
  }

  .footer__muted {
    color: var(--color-fg-dim);
  }

  .footer__mark {
    margin-top: clamp(3rem, 7vw, 5rem);
    font-size: clamp(5rem, 21vw, 21rem);
    font-weight: 300;
    font-variation-settings: "opsz" 32;
    letter-spacing: -0.065em;
    line-height: 0.78;
    color: transparent;
    background: linear-gradient(100deg, rgba(var(--rgb-accent), 0.42), rgba(var(--rgb-accent-2), 0.3) 60%, rgba(var(--rgb-pink), 0.12)), linear-gradient(180deg, transparent 40%, var(--color-bg));
    background-blend-mode: normal;
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
  }
</style>
