---
import type { Dictionary, Locale } from '../i18n/types';
import { locales, localeLabels } from '../i18n/types';
import { localizePath, switchLocalePath } from '../lib/paths';

interface Props {
  locale: Locale;
  dict: Dictionary;
  currentPath: string;
}

const { locale, dict, currentPath } = Astro.props;

const homePath = localizePath('', locale);
const isHome =
  currentPath === homePath ||
  currentPath === `${homePath}/` ||
  currentPath === '/' ||
  (locale !== 'uz' && currentPath === `/${locale}`);

const links = [
  { label: dict.nav.home, href: localizePath('', locale) },
  { label: dict.nav.about, href: localizePath('about', locale) },
  { label: dict.nav.solutions, href: localizePath('solutions', locale) },
  { label: dict.nav.technologies, href: localizePath('technologies', locale) },
  { label: dict.nav.contact, href: localizePath('contact', locale) },
];

function isActive(href: string): boolean {
  if (href === '/' || href === `/${locale}`) {
    return currentPath === href || currentPath === `${href}/`;
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header
  id="site-header"
  class:list={['site-header', { 'site-header--hero': isHome }]}
>
  <div class="header-shell">
    <div class="container-axion header-inner">
      <a href={homePath} class="relative z-50 flex items-center gap-2 shrink-0" aria-label="Axionlab">
        <img src="/icons/logo.svg" alt="Axionlab" width="140" height="30" class="header-logo h-7 w-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-2" aria-label="Primary">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', isActive(link.href) && 'is-active']}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span class="nav-link__frame" aria-hidden="true"></span>
            <span class="nav-link__label">{link.label}</span>
            <span class="nav-link__scan" aria-hidden="true"></span>
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <div
          class="hidden sm:flex items-center gap-1 rounded-full border border-border bg-bg-elevated/60 p-1 backdrop-blur-md"
          role="group"
          aria-label="Language"
        >
          {locales.map((l) => (
            <a
              href={switchLocalePath(currentPath, l)}
              class:list={[
                'px-2.5 py-1 text-xs font-mono tracking-wider rounded-full transition-colors',
                l === locale ? 'bg-accent text-white' : 'text-fg-muted hover:text-fg',
              ]}
              hreflang={l}
              aria-current={l === locale ? 'true' : undefined}
            >
              {localeLabels[l]}
            </a>
          ))}
        </div>

        <a
          href={localizePath('contact', locale)}
          class="btn-army hidden md:inline-flex items-center rounded-full bg-accent px-4 py-2 text-[0.9rem] text-white transition hover:brightness-110"
        >
          {dict.nav.cta}
        </a>

        <button
          id="menu-toggle"
          type="button"
          class="relative z-50 lg:hidden flex h-10 w-10 items-center justify-center rounded-md border border-border bg-bg-elevated/80 backdrop-blur-md"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menu"
        >
          <span class="menu-icon flex flex-col gap-1.5">
            <span class="block h-0.5 w-5 bg-fg transition-transform origin-center"></span>
            <span class="block h-0.5 w-5 bg-fg transition-opacity"></span>
            <span class="block h-0.5 w-5 bg-fg transition-transform origin-center"></span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 hidden bg-bg/95 backdrop-blur-xl lg:hidden"
    aria-hidden="true"
  >
    <div class="container-axion flex h-full flex-col pt-24 pb-10">
      <nav class="flex flex-col gap-2" aria-label="Mobile">
        {links.map((link) => (
          <a
            href={link.href}
            data-mobile-link
            class:list={['nav-link nav-link--mobile', isActive(link.href) && 'is-active']}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span class="nav-link__frame" aria-hidden="true"></span>
            <span class="nav-link__label">{link.label}</span>
          </a>
        ))}
      </nav>

      <div class="mt-8 flex items-center gap-2" role="group" aria-label="Language">
        {locales.map((l) => (
          <a
            href={switchLocalePath(currentPath, l)}
            class:list={[
              'px-4 py-2 text-sm font-mono tracking-wider rounded-full border transition-colors',
              l === locale
                ? 'border-accent bg-accent text-white'
                : 'border-border text-fg-muted hover:text-fg',
            ]}
            hreflang={l}
          >
            {localeLabels[l]}
          </a>
        ))}
      </div>

      <a
        href={localizePath('contact', locale)}
        data-mobile-link
        class="btn-army mt-auto inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-lg text-white"
      >
        {dict.nav.cta}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const links = menu?.querySelectorAll('[data-mobile-link]');
  let solid = false;

  const onScroll = () => {
    if (!header) return;
    const isHero = header.classList.contains('site-header--hero');
    if (!isHero) {
      header.classList.add('is-solid');
      return;
    }
    const y = window.scrollY;
    // Hysteresis avoids flicker at the threshold
    if (y <= 0) solid = false;
    else if (!solid && y > 56) solid = true;
    else if (solid && y < 16) solid = false;
    header.classList.toggle('is-solid', solid);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    menu.setAttribute('aria-hidden', String(!open));
    document.body.style.overflow = open ? 'hidden' : '';
    toggle.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
  });

  links?.forEach((link) => link.addEventListener('click', () => setOpen(false)));

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    padding: 0;
    transition: padding 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header--hero {
    position: fixed;
    inset: 0 0 auto;
  }

  .header-shell {
    position: relative;
    width: 100%;
    border-radius: 0;
    border: 1px solid transparent;
    background: rgba(11, 18, 32, 0.82);
    box-shadow: 0 0 0 transparent;
    backdrop-filter: blur(20px) saturate(1.35);
    -webkit-backdrop-filter: blur(20px) saturate(1.35);
    transition:
      background 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      backdrop-filter 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      -webkit-backdrop-filter 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Fully transparent at top of hero — no blur, no tint */
  .site-header--hero:not(.is-solid) .header-shell {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    backdrop-filter: blur(0px) saturate(1);
    -webkit-backdrop-filter: blur(0px) saturate(1);
  }

  /* Float to container width — matches .container-axion */
  .site-header--hero.is-solid {
    padding: 0.75rem clamp(1.25rem, 4vw, 2.5rem) 0;
  }

  .site-header--hero.is-solid .header-shell {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    border-radius: 16px;
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(11, 18, 32, 0.78);
    box-shadow:
      0 12px 40px rgba(3, 11, 20, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
    transition:
      height 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header--hero.is-solid .header-inner {
    height: 3.6rem;
    max-width: none;
    padding-inline: 1rem;
  }

  @media (min-width: 768px) {
    .site-header--hero.is-solid .header-inner {
      padding-inline: 1.25rem;
    }
  }

  /* Always-solid pages (non-home): keep shell edge padding tight */
  .site-header:not(.site-header--hero) .header-inner {
    padding-inline: clamp(0.85rem, 2vw, 1.25rem);
  }

  .site-header--hero.is-solid .header-logo {
    transform: scale(0.94);
  }

  /* Anti-drone / C2 targeting lock for active nav */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.35rem;
    padding: 0.45rem 0.9rem;
    color: var(--color-fg-muted);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }

  .nav-link:hover {
    color: var(--color-fg);
  }

  .nav-link__label {
    position: relative;
    z-index: 1;
  }

  .nav-link__frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .nav-link__frame::before,
  .nav-link__frame::after {
    content: '';
    position: absolute;
    width: 0.55rem;
    height: 0.55rem;
    border: 1.5px solid var(--color-accent);
    transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1), height 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link__frame::before {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }

  .nav-link__frame::after {
    right: 0;
    bottom: 0;
    border-left: 0;
    border-top: 0;
  }

  .nav-link__scan {
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0.2rem;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    background: rgba(21, 112, 239, 0.25);
    pointer-events: none;
  }

  .nav-link__scan::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 35%;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    transform: translateX(-120%);
  }

  .nav-link.is-active {
    color: var(--color-accent);
    background: rgba(21, 112, 239, 0.08);
    text-shadow: 0 0 18px rgba(21, 112, 239, 0.35);
  }

  .nav-link.is-active .nav-link__frame {
    opacity: 1;
  }

  .nav-link.is-active .nav-link__frame::before {
    box-shadow:
      0 0 0 1px rgba(21, 112, 239, 0.15),
      inset 8px 0 0 -7px var(--color-accent),
      inset 0 8px 0 -7px var(--color-accent);
  }

  /* Top-right + bottom-left corners via extra paints on the frame */
  .nav-link.is-active .nav-link__frame {
    background:
      linear-gradient(var(--color-accent), var(--color-accent)) top right / 0.55rem 1.5px no-repeat,
      linear-gradient(var(--color-accent), var(--color-accent)) top right / 1.5px 0.55rem no-repeat,
      linear-gradient(var(--color-accent), var(--color-accent)) bottom left / 0.55rem 1.5px no-repeat,
      linear-gradient(var(--color-accent), var(--color-accent)) bottom left / 1.5px 0.55rem no-repeat,
      rgba(21, 112, 239, 0.04);
  }

  .nav-link.is-active .nav-link__scan {
    opacity: 1;
  }

  .nav-link.is-active .nav-link__scan::after {
    animation: targetScan 2.2s ease-in-out infinite;
  }

  .nav-link--mobile {
    width: 100%;
    justify-content: flex-start;
    min-height: auto;
    padding: 1rem 0.85rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.35rem;
  }

  .nav-link--mobile.is-active {
    background: rgba(21, 112, 239, 0.1);
  }

  @keyframes targetScan {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(320%);
    }
  }

  #menu-toggle.is-open .menu-icon span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-toggle.is-open .menu-icon span:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle.is-open .menu-icon span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-shell,
    .header-inner,
    .header-logo {
      transition: none !important;
    }

    .nav-link.is-active .nav-link__scan::after {
      animation: none;
      transform: none;
      width: 100%;
      opacity: 0.7;
    }
  }
</style>
