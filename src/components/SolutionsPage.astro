---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import ClosingCTA from './ClosingCTA.astro';
import MissionVisual from './story/MissionVisual.astro';
import { getDictionary, type Locale } from '../i18n';
import { localizePath } from '../lib/paths';

interface Props {
  locale?: Locale;
}

const locale = (Astro.props.locale ?? 'uz') as Locale;
const dict = getDictionary(locale);
const page = dict.solutionsPage;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: dict.nav.home,
      item: `https://axionlab.uz${localizePath('', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: dict.nav.solutions,
      item: `https://axionlab.uz${localizePath('solutions', locale)}`,
    },
  ],
};
---

<Layout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={localizePath('solutions', locale)}
  jsonLd={breadcrumb}
>
  <PageHero label={page.label} title={page.title} subtitle={page.subtitle} />

  <section class="section-pad">
    <div class="container-axion sol-list">
      {dict.solutions.items.map((item, i) => (
        <article id={item.id} class:list={['sol', { 'sol--flip': i % 2 === 1 }]}>
          <div class="sol__visual panel" data-media-reveal>
            <MissionVisual id={item.id} />
          </div>
          <div class="sol__copy reveal" style="transition-delay: 100ms">
            <p class="kicker">
              <span class="kicker__idx">{item.index.replace(/[\[\]]/g, '')}</span>
              <span class="kicker__rule" aria-hidden="true"></span>
              <span>{dict.nav.solutions}</span>
            </p>
            <h2 class="headline headline--sm">{item.title}</h2>
            <p class="sol__body">{item.description}</p>
            <ul class="sol__points">
              {item.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <ClosingCTA dict={dict} locale={locale} />
</Layout>

<style>
  .sol-list {
    display: grid;
    gap: clamp(4rem, 9vw, 7rem);
  }

  .sol {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    scroll-margin-top: 6rem;
  }

  @media (min-width: 900px) {
    .sol {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 4rem;
    }

    .sol--flip .sol__visual {
      order: 2;
    }
  }

  .sol__visual {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 50% 100%, rgba(var(--rgb-fg), 0.04), transparent 70%), var(--color-bg-elevated);
  }

  .sol__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sol__body {
    color: var(--color-fg-muted);
    line-height: 1.65;
  }

  .sol__points {
    display: grid;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .sol__points li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .sol__points li::before {
    content: '';
    width: 0.9rem;
    height: 1px;
    flex-shrink: 0;
    background: var(--color-fg-dim);
  }
</style>
