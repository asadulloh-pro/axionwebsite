---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import ClosingCTA from './ClosingCTA.astro';
import DeviceIcon from './story/DeviceIcon.astro';
import { getDictionary, type Locale } from '../i18n';
import { localizePath } from '../lib/paths';

interface Props {
  locale?: Locale;
}

const locale = (Astro.props.locale ?? 'uz') as Locale;
const dict = getDictionary(locale);
const page = dict.technologiesPage;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: dict.nav.home,
      item: `https://axionlab.uz${localizePath('', locale)}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: dict.nav.technologies,
      item: `https://axionlab.uz${localizePath('technologies', locale)}`,
    },
  ],
};
---

<Layout
  locale={locale}
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalPath={localizePath('technologies', locale)}
  jsonLd={breadcrumb}
>
  <PageHero label={page.label} title={page.title} subtitle={page.subtitle} />

  <section class="section-pad">
    <div class="container-axion">
      <ol class="row-list">
        {dict.technologies.items.map((item, i) => (
          <li class="row reveal" style={`transition-delay: ${i * 50}ms`}>
            <span class="row__idx">{item.index.replace(/[\[\]]/g, '')}</span>
            <h2 class="row__title">{item.title}</h2>
            <p class="row__body">{item.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="tech-integration">
    <div class="container-axion">
      <div class="tech-integration__panel panel reveal">
        <div class="tech-integration__copy">
          <h2 class="headline headline--sm">{page.integrationTitle}</h2>
          <p class="tech-integration__body">{page.integrationBody}</p>
        </div>
        <ul class="tech-integration__devices" aria-label={dict.technologiesPage.integrationTitle}>
          {dict.story.devices.map((device) => (
            <li>
              <DeviceIcon id={device.id} size={22} />
              <span>{device.short}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <ClosingCTA dict={dict} locale={locale} />
</Layout>

<style>
  .tech-integration__panel {
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--color-bg-elevated);
  }

  @media (min-width: 900px) {
    .tech-integration__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .tech-integration__body {
    margin-top: 1rem;
    color: var(--color-fg-muted);
    line-height: 1.65;
  }

  .tech-integration__devices {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech-integration__devices li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 0.5rem;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  .tech-integration__devices :global(svg) {
    color: var(--color-accent-soft);
  }
</style>
