---
import type { ProjectC2C4 } from '../../i18n/types';

/*
 * Command center: operator consoles in front of a video wall running the C4 dashboard, laid out like the
 * real C4 client (KPI cards, monitoring panel, zone map, control zones strip, incident log). Driven by the
 * enclosing chapter's --p: the wall powers on and every site comes online, the camera pushes into the
 * wall (--zoom, set by the page while pinned), a drone enters the border post zone, an incident is logged
 * and the operator hands control to that site's C2.
 */
interface Props {
  ui: ProjectC2C4['c4ui'];
  devices: string[];
  caption: string;
}

const { ui, devices, caption } = Astro.props;

const nodeAt = (i: number) => (0.4 + i * 0.025).toFixed(3);
/* Zone centres on the 600x220 map. */
const spots = [
  [150, 130],
  [270, 75],
  [470, 70],
  [360, 150],
  [80, 65],
  [530, 165],
  [235, 180],
];
const identified = [3, 2, 1, 2, 2, 1, 2];
const nodes = ui.sites.map((name, i) => ({
  name,
  at: nodeAt(i),
  x: spots[i][0],
  y: spots[i][1],
  low: identified[i],
  alert: i === 2,
}));
const incident = nodes[2];
const DRONE_PATH = `M640 -20 C600 30 540 40 ${incident.x + 18} ${incident.y - 14}`;
/* Device markers inside the incident zone, shown once the map flies to it. */
const deviceSpots = [
  [-14, -9],
  [13, -12],
  [-15, 10],
  [14, 9],
  [0, 1],
];
const stepAt = [0.4, 0.62, 0.76, 0.86, 1.01];
---

<figure class="c4w" data-c4>
  <div class="c4w__room">
    <img class="c4w__photo" src="/images/command-center.webp" width="1280" height="720" alt="" loading="lazy" decoding="async" />
    <div class="c4w__wall" data-wall>
      <div class="c4w__display">
        <div class="c4w__boot" aria-hidden="true">
          <span>{ui.title}</span>
          <span class="c4w__boot-line">{ui.linking}</span>
        </div>

        <div class="c4" role="img" aria-label={`${ui.title}: ${ui.sites.join(', ')}`}>
          <header class="c4__top">
            <span class="c4__brand"><i></i>{ui.title}</span>
            <ul class="c4__tabs">
              {ui.tabs.map((tab, i) => <li class={i === 0 ? 'is-active' : undefined}>{tab}</li>)}
            </ul>
            <span class="c4__crumb">→ {incident.name} · C2</span>
            <span class="c4__clock">05/11/2026 08:41</span>
            <span class="c4__bell">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2a4 4 0 0 0-4 4v3l-1.5 2.5h11L12 9V6a4 4 0 0 0-4-4ZM6.5 13a1.5 1.5 0 0 0 3 0" /></svg>
              <b>1</b>
            </span>
            <span class="c4__live"><i></i>{ui.live}</span>
          </header>

          <ul class="c4__kpis">
            <li class="c4__kpi">
              <span>{ui.kpis[0]}</span>
              <b class="c4__num" style="--n: calc(13 + var(--hit))"></b>
            </li>
            <li class="c4__kpi c4__kpi--alert">
              <span>{ui.kpis[1]}</span>
              <b class="c4__num" style="--n: calc(var(--hit))"></b>
            </li>
            <li class="c4__kpi c4__kpi--inc">
              <span>{ui.kpis[2]} <em>{ui.today}</em></span>
              <b class="c4__num" style="--n: calc(var(--inc))"></b>
            </li>
            <li class="c4__kpi">
              <span>{ui.kpis[3]}</span>
              <b class="c4__num" style="--n: var(--online)"></b>
              <small>
                <em class="c4__tag c4__tag--ok">{ui.online}: <b class="c4__num" style="--n: var(--online)"></b></em>
                <em class="c4__tag">{ui.offline}: 0</em>
              </small>
            </li>
          </ul>

          <div class="c4__body">
            <section class="c4__panel c4__panel--left">
              <p class="c4__title">{ui.monitoring}</p>
              <div class="c4__seg">
                <i></i>
                <span>{ui.segments[0]}</span>
                <span>{ui.segments[1]}</span>
              </div>
              <span class="c4__search">
                <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" /><path d="m10.5 10.5 3 3" /></svg>
                {ui.search}
              </span>

              <div class="c4__stack">
                <ul class="c4__nodes c4__layer">
                  {nodes.map((n) => (
                    <li class={`c4__node rv${n.alert ? ' c4__node--alert' : ''}`} style={`--at:${n.at}`}>
                      <i></i>
                      <span>{n.name}</span>
                      {n.alert ? <b>1</b> : <em>{ui.online}</em>}
                    </li>
                  ))}
                </ul>

                <article class="c4__det c4__layer">
                  <p class="c4__det-zone">
                    {incident.name}
                    <span>C2 · {ui.nodeUnit}</span>
                  </p>
                  <p class="c4__tags">
                    <em class="c4__tag c4__tag--info">{ui.confidence}: 2</em>
                    <em class="c4__tag c4__tag--bad">{ui.unidentified}</em>
                  </p>
                  <div class="c4__det-uav">
                    <svg viewBox="0 0 40 40" aria-hidden="true">
                      <path d="M8 8l24 24M32 8 8 32" />
                      <circle cx="8" cy="8" r="5" />
                      <circle cx="32" cy="8" r="5" />
                      <circle cx="8" cy="32" r="5" />
                      <circle cx="32" cy="32" r="5" />
                      <rect x="15" y="15" width="10" height="10" rx="2" />
                    </svg>
                    <span>
                      <b>{ui.model}</b>
                      ID 1581F6Q8D23
                    </span>
                  </div>
                  <p class="c4__tags">
                    <em class="c4__tag c4__tag--ok">41.284 - 69.317</em>
                    <em class="c4__tag c4__tag--ok">{ui.alt} 120 m</em>
                  </p>
                  <p class="c4__det-time">{ui.detected} · 08:41:09</p>
                </article>
              </div>
            </section>

            <section class="c4__centre">
              <div class="c4__map">
                <svg viewBox="0 0 600 220" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                  <defs>
                    <pattern id="c4-grid" width="30" height="30" patternUnits="userSpaceOnUse">
                      <path d="M30 0H0V30" class="c4__grid" />
                    </pattern>
                  </defs>
                  <rect x="-200" y="-200" width="1000" height="660" class="c4__ground" />
                  <g class="c4__world">
                    <rect x="-200" y="-200" width="1000" height="660" fill="url(#c4-grid)" />
                    <path d="M-20 105 C80 85 140 150 230 130 S380 50 470 105 S560 200 640 185" class="c4__river" />
                    <path d="M-20 40 C120 20 220 70 340 40 S520 10 640 30" class="c4__contour" />
                    <path d="M-20 205 C110 185 230 220 360 195 S520 175 640 190" class="c4__contour" />
                    <path d="M40 240 L150 130 L270 75 L470 70 M150 130 L360 150 L530 165 M235 180 L360 150 M80 65 L150 130" class="c4__road" />

                    {nodes.map((n) => (
                      <g class={`c4__zone rv${n.alert ? ' c4__zone--alert' : ''}`} style={`--at:${n.at}`} transform={`translate(${n.x} ${n.y})`}>
                        <circle r="30" class="c4__zone-area" />
                        <circle r="3.5" class="c4__zone-ping" />
                        <circle r="3.5" class="c4__zone-node" />
                        <g transform="translate(0 -40)">
                          <rect x={-(n.name.length * 2.9 + 8)} y="-7.5" width={n.name.length * 5.8 + 16} height="15" rx="7.5" class="c4__pill" />
                          <text text-anchor="middle" dy="3.2" class="c4__pill-text">{n.name}</text>
                        </g>
                      </g>
                    ))}

                    <g class="c4__site" transform={`translate(${incident.x} ${incident.y})`}>
                      <circle r="27" class="c4__coverage" />
                      {deviceSpots.map(([x, y], i) => (
                        <g transform={`translate(${x} ${y})`}>
                          <circle r="1.9" class="c4__device" />
                          <text y="-3.2" text-anchor="middle" class="c4__device-text">{devices[i]}</text>
                        </g>
                      ))}
                    </g>

                    <path d={DRONE_PATH} pathLength="1" class="c4__trail" />
                    <g class="c4__drone" style={`offset-path: path('${DRONE_PATH}')`}>
                      <circle r="9" class="c4__drone-ring" />
                      <path d="M-4 -4 4 4M4 -4-4 4" class="c4__drone-x" />
                      <circle r="1.8" class="c4__drone-core" />
                    </g>
                  </g>
                </svg>
              </div>

              <div class="c4__zones">
                <p class="c4__title">{ui.zonesLabel}</p>
                <ul>
                  {nodes.map((n) => (
                    <li class={`c4__zcard rv${n.alert ? ' c4__zcard--alert' : ''}`} style={`--at:${n.at}`}>
                      <b>{n.name}</b>
                      <span>{ui.nodeUnit}</span>
                      <p>
                        <em class="c4__count c4__count--bad">{n.alert ? <b class="c4__num" style="--n: calc(var(--hit))"></b> : 0}</em>
                        <em class="c4__count c4__count--mid">0</em>
                        <em class="c4__count c4__count--ok">{n.low}</em>
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            </section>

            <section class="c4__panel c4__panel--right">
              <div class="c4__stack">
                <div class="c4__log c4__layer">
                  <p class="c4__title">
                    {ui.incidentsLabel}
                    <b class="c4__num" style="--n: calc(var(--inc))"></b>
                  </p>
                  <p class="c4__empty">{ui.noIncidents}</p>
                  <div class="c4__inc">
                    <p class="c4__inc-head">
                      <span>#1</span>
                      <span>08:41:12</span>
                    </p>
                    <em class="c4__tag c4__tag--bad">{ui.incidentType}</em>
                    <p class="c4__inc-where">{incident.name} · C2</p>
                    <span class="c4__go">
                      {ui.openC2} →
                      <i class="c4__ripple"></i>
                    </span>
                  </div>
                  <svg class="c4__cursor" viewBox="0 0 16 20" aria-hidden="true"><path d="M1 1v15l4-4 3 7 3-1.4-3-6.6h6Z" /></svg>
                </div>

                <div class="c4__devs c4__layer">
                  <p class="c4__title">{ui.devicesLabel} · {incident.name}</p>
                  <ul>
                    {devices.map((d) => (
                      <li>
                        <i></i>
                        <span>{d}</span>
                        <em>{ui.online}</em>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
      <div class="c4w__glass" aria-hidden="true"></div>
    </div>
  </div>

  <div class="c4w__below">
    <ol class="c4w__steps" aria-hidden="true">
      {ui.steps.map((step, i) => (
        <li class="c4w__step" style={`--s0:${stepAt[i]};--s1:${stepAt[i + 1]}`}>
          <span class="c4w__step-n">{String(i + 1).padStart(2, '0')}</span>
          <span>{step}</span>
          <i></i>
        </li>
      ))}
    </ol>
    <figcaption class="c4w__caption hud">{caption}</figcaption>
  </div>
</figure>

<script>
  /*
   * While the chapter is pinned the page pushes the camera into the wall: the room is scaled so the
   * wall fills the viewport width, and the steps sit just under the zoomed wall. Offsets ignore CSS
   * transforms, so the result is stable whatever --p is when it is measured.
   */
  function offset(el: HTMLElement) {
    let x = 0;
    let y = 0;
    for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) {
      x += n.offsetLeft;
      y += n.offsetTop;
    }
    return { x, y };
  }

  function layout(fig: HTMLElement) {
    const chapter = fig.closest<HTMLElement>('[data-chapter]');
    const room = fig.querySelector<HTMLElement>('.c4w__room');
    const wall = fig.querySelector<HTMLElement>('[data-wall]');
    if (!chapter || !room || !wall || !wall.offsetWidth) return;

    const c = offset(chapter);
    const r = offset(room);
    const f = offset(fig);
    const vw = chapter.clientWidth;
    const vh = window.innerHeight;
    const top = 88;
    const below = 110;
    const pad = Math.max(24, vw * 0.04);
    const aspect = wall.offsetWidth / wall.offsetHeight;
    const w = Math.min(vw - pad * 2, (vh - top - below) * aspect);
    const h = w / aspect;
    const left = (vw - w) / 2;
    const s = w / wall.offsetWidth;

    fig.style.setProperty('--zs', s.toFixed(4));
    fig.style.setProperty('--zx', `${(left - (r.x - c.x) - s * wall.offsetLeft).toFixed(1)}px`);
    fig.style.setProperty('--zy', `${(top - (r.y - c.y) - s * wall.offsetTop).toFixed(1)}px`);
    fig.style.setProperty('--bx', `${(left - (f.x - c.x)).toFixed(1)}px`);
    fig.style.setProperty('--by', `${(top + h + 14 - (f.y - c.y)).toFixed(1)}px`);
    fig.style.setProperty('--bw', `${w.toFixed(1)}px`);
  }

  document.querySelectorAll<HTMLElement>('[data-c4]').forEach((fig) => {
    const run = () => layout(fig);
    const chapter = fig.closest<HTMLElement>('[data-chapter]');
    if (chapter) new ResizeObserver(run).observe(chapter);
    new MutationObserver(run).observe(chapter ?? fig, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('resize', run);
    fig.querySelector('img')?.addEventListener('load', run);
    run();
  });
</script>

<style>
  @property --n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  .c4w {
    --zoom: var(--c4-zoom, 0);
    --power: clamp(0, (var(--p) - 0.3) * 12, 1);
    --online: clamp(0, (var(--p) - 0.4) / 0.025 + 0.5, 7);
    --dr: clamp(0, (var(--p) - 0.62) / 0.1, 1);
    --hit: clamp(0, (var(--p) - 0.68) * 25, 1);
    --det-t: clamp(0, (var(--p) - 0.7) / 0.045, 1);
    --det: calc(var(--det-t) * var(--det-t) * (3 - 2 * var(--det-t)));
    --inc-t: clamp(0, (var(--p) - 0.76) / 0.04, 1);
    --inc: calc(var(--inc-t) * var(--inc-t) * (3 - 2 * var(--inc-t)));
    --go: clamp(0, (var(--p) - 0.8) * 30, 1);
    --cur-t: clamp(0, (var(--p) - 0.8) / 0.05, 1);
    --cur: calc(var(--cur-t) * var(--cur-t) * (3 - 2 * var(--cur-t)));
    --clk: clamp(0, (var(--p) - 0.855) / 0.035, 1);
    --fly-t: clamp(0, (var(--p) - 0.87) / 0.09, 1);
    --fly: calc(var(--fly-t) * var(--fly-t) * (3 - 2 * var(--fly-t)));
    --bad: 230, 72, 86;
    --mid: 222, 150, 40;
    --ok: 88, 196, 96;
    --zone: 59, 130, 246;
    --teal: 20, 184, 166;
    position: relative;
    margin: 0;
    width: 100%;
  }

  .rv {
    opacity: clamp(0, (var(--p) - var(--at)) * 25, 1);
  }

  .c4__num {
    counter-reset: n var(--n);
  }

  .c4__num::before {
    content: counter(n);
  }

  .c4w__room {
    position: relative;
    transform-origin: 0 0;
    transform: translate(calc(var(--zx, 0px) * var(--zoom)), calc(var(--zy, 0px) * var(--zoom)))
      scale(calc(1 + (var(--zs, 1) - 1) * var(--zoom)));
  }

  .c4w__photo {
    display: block;
    width: 100%;
    height: auto;
    opacity: calc(1 - var(--zoom));
  }

  /* Matches the video wall of command-center.webp. */
  .c4w__wall {
    position: absolute;
    left: 15.7%;
    top: 17.92%;
    width: 68.52%;
    height: 43.06%;
    overflow: hidden;
    container-type: size;
    background: #05080e;
    border-radius: calc(var(--zoom) * 0.25cqw);
    box-shadow:
      0 0 calc(var(--power) * 6cqw) rgba(var(--rgb-accent), calc(var(--power) * 0.28)),
      0 0 0 calc(var(--zoom) * 0.12cqw) rgba(var(--rgb-fg), 0.14);
  }

  .c4w__display {
    position: absolute;
    inset: 0;
    opacity: var(--power);
    background: radial-gradient(120% 100% at 50% 30%, #0b1324, #05080e);
  }

  .c4w__glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.04), transparent 40%),
      repeating-linear-gradient(90deg, transparent 0 calc(25% - 1px), rgba(0, 0, 0, 0.45) calc(25% - 1px) 25%);
    box-shadow: inset 0 0 2cqw rgba(0, 0, 0, 0.7);
    opacity: calc(1 - var(--zoom) * 0.75);
  }

  .c4w__boot {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3cqh;
    font-family: var(--font-mono);
    font-size: 7cqh;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: min(1, clamp(0, (0.395 - var(--p)) * 25, 1));
  }

  .c4w__boot-line {
    font-size: 4cqh;
    letter-spacing: 0.14em;
    color: var(--color-accent-soft);
  }

  /* Steps and caption: in flow on small screens, under the zoomed wall while pinned. */
  .c4w__below {
    margin-top: 0.8rem;
  }

  :global(.is-pinned) .c4w__below {
    position: absolute;
    left: var(--bx, 0);
    top: var(--by, 100%);
    width: var(--bw, 100%);
    margin: 0;
    opacity: var(--zoom);
    transform: translateY(calc((1 - var(--zoom)) * 1rem));
  }

  .c4w__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c4w__step {
    --on: min(clamp(0, (var(--p) - var(--s0)) * 25, 1), clamp(0, (var(--s1) - var(--p)) * 25, 1));
    --done: clamp(0, (var(--p) - var(--s0)) * 25, 1);
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding-top: 0.55rem;
    font-size: 0.88rem;
    line-height: 1.3;
    color: rgba(var(--rgb-fg), calc(0.62 + var(--on) * 0.38));
  }

  .c4w__step-n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(var(--rgb-accent), calc(0.6 + var(--done) * 0.4));
  }

  .c4w__step i {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: rgba(var(--rgb-fg), 0.18);
  }

  .c4w__step i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-brand, var(--color-accent));
    transform: scaleX(var(--done));
    transform-origin: left;
  }

  .c4w__caption {
    margin-top: 0.5rem;
    text-align: right;
    color: rgba(var(--rgb-fg), 0.55);
  }

  /* Dashboard */
  .c4 {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    font-size: 1.15cqw;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.88);
    opacity: clamp(0, (var(--p) - 0.38) * 20, 1);
  }

  .c4 p {
    margin: 0;
  }

  .c4 ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c4 em {
    font-style: normal;
  }

  .c4 svg {
    display: block;
  }

  .c4__top {
    display: flex;
    align-items: center;
    gap: 1.6em;
    height: 2.5em;
    padding: 0 1.2em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.025);
  }

  .c4__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .c4__brand i {
    width: 0.9em;
    height: 0.9em;
    border-radius: 0.2em;
    background: var(--grad-brand, var(--color-accent));
  }

  .c4__tabs {
    display: flex;
    gap: 0.4em;
    height: 100%;
  }

  .c4__tabs li {
    display: flex;
    align-items: center;
    padding: 0 0.8em;
    font-size: 0.9em;
    color: rgba(255, 255, 255, 0.5);
  }

  .c4__tabs .is-active {
    color: #fff;
    box-shadow: inset 0 -2px rgb(var(--teal));
  }

  .c4__crumb {
    padding: 0.25em 0.7em;
    border: 1px solid rgba(var(--teal), 0.6);
    border-radius: 999px;
    font-size: 0.8em;
    color: rgb(var(--teal));
    opacity: var(--fly);
    transform: translateX(calc((1 - var(--fly)) * -0.8em));
  }

  .c4__clock {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: rgba(255, 255, 255, 0.6);
  }

  .c4__bell {
    position: relative;
    width: 1.2em;
    height: 1.2em;
  }

  .c4__bell svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgba(255, 255, 255, 0.7);
    stroke-width: 1.3;
  }

  .c4__bell b {
    position: absolute;
    top: -0.45em;
    right: -0.55em;
    display: grid;
    place-items: center;
    width: 1.15em;
    height: 1.15em;
    border-radius: 999px;
    background: rgb(var(--bad));
    font-size: 0.65em;
    color: #fff;
    transform: scale(var(--inc));
  }

  .c4__live {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-mono);
    font-size: 0.8em;
    text-transform: uppercase;
    color: rgb(var(--ok));
  }

  .c4__live i {
    width: 0.55em;
    height: 0.55em;
    border-radius: 999px;
