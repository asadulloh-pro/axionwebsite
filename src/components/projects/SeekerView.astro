---
import type { ProjectInterceptor } from '../../i18n/types';

/*
 * The interceptor's onboard camera, as its AI seeker sees it. Driven by the enclosing chapter's --p:
 * flying to the coordinates radar sent, search, the target appears and is tracked, locked, briefly hidden by cloud while the track holds,
 * then the terminal run and impact. The operator can abort until the terminal phase.
 */
interface Props {
  ui: ProjectInterceptor['seekerUi'];
  caption: string;
}

const { ui, caption } = Astro.props;

const stageAt = [0.03, 0.14, 0.25, 0.62, 0.85, 1.01];
const stepAt = [0.2, 0.42, 0.5, 0.85, 1.01];
---

<figure class="sk">
  <div class="sk__frame">
    <div class="sk__feed" role="img" aria-label={`${ui.title}: ${ui.stages.join(', ')}`}>
      <div class="sk__sky"></div>
      <svg class="sk__ground" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 70 L40 52 L80 64 L130 40 L170 58 L220 36 L270 60 L310 46 L360 62 L400 50 V120 H0 Z" class="sk__ridge" />
        <path d="M0 92 L60 78 L120 90 L190 74 L250 88 L320 76 L400 86 V120 H0 Z" class="sk__ridge sk__ridge--near" />
      </svg>
      <div class="sk__scan" aria-hidden="true"></div>

      <div class="sk__target" aria-hidden="true">
        <svg viewBox="-50 -30 100 60">
          <path d="M44 0 L-6 -6 L-36 -26 L-40 -26 L-30 -4 L-44 -3 L-44 3 L-30 4 L-40 26 L-36 26 L-6 6 Z" />
        </svg>
        <span class="sk__box">
          <i></i><i></i><i></i><i></i>
          <b class="sk__tag">
            <span class="sk__tag-name">{ui.target}</span>
            <span class="sk__tag-held">{ui.held}</span>
          </b>
        </span>
      </div>

      <div class="sk__cloud" aria-hidden="true"></div>

      <span class="sk__reticle" aria-hidden="true"></span>
      <span class="sk__wp" aria-hidden="true"><i></i>{ui.stages[0]}</span>

      <div class="sk__hud sk__hud--tl">
        <span class="sk__rec"><i></i>{ui.rec}</span>
        <span>{ui.title}</span>
      </div>
      <ul class="sk__badges">
        {ui.badges.map((b) => <li>{b}</li>)}
      </ul>

      <dl class="sk__telemetry">
        <div>
          <dt>{ui.track}</dt>
          <dd>TRK-07</dd>
        </div>
        <div>
          <dt>{ui.confidence}</dt>
          <dd><b class="sk__num" style="--n: calc(71 + 25 * clamp(0, (var(--p) - 0.25) / 0.2, 1))"></b>%</dd>
        </div>
        <div>
          <dt>{ui.range}</dt>
          <dd><b class="sk__num" style="--n: calc(1800 * (1 - var(--k)))"></b> m</dd>
        </div>
        <div>
          <dt>{ui.speed}</dt>
          <dd><b class="sk__num" style="--n: calc(150 + 50 * clamp(0, (var(--p) - 0.62) / 0.15, 1))"></b> km/h</dd>
        </div>
      </dl>

      <ol class="sk__stages">
        {ui.stages.map((stage, i) => (
          <li style={`--s0:${stageAt[i]};--s1:${stageAt[i + 1]}`}>{stage}</li>
        ))}
      </ol>

      <div class="sk__flash" aria-hidden="true"></div>
      <p class="sk__done">{ui.destroyed}</p>
    </div>

    <div class="sk__operator">
      <span class="sk__op-label">{ui.operator}</span>
      <span class="sk__op-ok">✓ {ui.approved}</span>
      <span class="sk__abort">
        <span class="sk__abort-on">{ui.abort}</span>
        <span class="sk__abort-off">{ui.terminal}</span>
      </span>
    </div>
  </div>

  <ol class="sk__steps" aria-hidden="true">
    {ui.steps.map((step, i) => (
      <li class="sk__step" style={`--s0:${stepAt[i]};--s1:${stepAt[i + 1]}`}>
        <span class="sk__step-n">{String(i + 1).padStart(2, '0')}</span>
        <span>{step}</span>
        <i></i>
      </li>
    ))}
  </ol>
  <figcaption class="sk__caption hud">{caption}</figcaption>
</figure>

<style>
  @property --n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  .sk {
    --on: clamp(0, (var(--p) - 0.03) * 25, 1);
    --seen: clamp(0, (var(--p) - 0.2) * 20, 1);
    --track: clamp(0, (var(--p) - 0.25) * 25, 1);
    --lock: clamp(0, (var(--p) - 0.42) * 25, 1);
    --cloud: clamp(0, (var(--p) - 0.44) / 0.2, 1);
    --held: min(clamp(0, (var(--p) - 0.5) * 30, 1), clamp(0, (0.58 - var(--p)) * 30, 1));
    --term: clamp(0, (var(--p) - 0.62) * 25, 1);
    --hit: clamp(0, (var(--p) - 0.85) * 30, 1);
    --k-t: clamp(0, (var(--p) - 0.2) / 0.65, 1);
    --k: calc(var(--k-t) * var(--k-t) * var(--k-t));
    --red: 255, 79, 122;
    --ok: 88, 210, 130;
    margin: 0;
    width: 100%;
  }

  .sk__num {
    counter-reset: n var(--n);
  }

  .sk__num::before {
    content: counter(n);
  }

  .sk__frame {
    overflow: hidden;
    border: 1px solid rgba(var(--rgb-fg), 0.16);
    border-radius: 0.6rem;
    background: #04060b;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.55);
  }

  .sk__feed {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    container-type: size;
    font-family: var(--font-mono);
    font-size: 1.15cqw;
    color: rgba(225, 240, 230, 0.92);
    opacity: var(--on);
  }

  .sk__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 70% 0%, rgba(120, 150, 170, 0.35), transparent 60%),
      linear-gradient(180deg, #1d2a33 0%, #2c3b42 55%, #3a4441 100%);
    filter: grayscale(0.4) contrast(1.1);
  }

  .sk__ground {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 34%;
    transform: translateY(calc(var(--k) * 30%));
  }

  .sk__ridge {
    fill: #222a28;
  }

  .sk__ridge--near {
    fill: #161b1a;
  }

  .sk__scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0 46%, rgba(140, 255, 190, 0.18) 50%, transparent 54%);
    background-size: 100% 220%;
    opacity: calc(1 - var(--track));
    animation: sk-scan 2.2s linear infinite;
  }

  /* Target: drifts from far top right toward the centre and grows as the interceptor closes in. */
  .sk__target {
    --size: calc(3cqw + 34cqw * var(--k));
    position: absolute;
    left: calc(78% - 27% * var(--k-t));
    top: calc(24% + 20% * var(--k-t));
    width: var(--size);
    height: calc(var(--size) * 0.6);
    transform: translate(-50%, -50%);
    opacity: calc(var(--seen) * (1 - var(--hit)));
    animation: sk-wobble 3.2s ease-in-out infinite;
  }

  .sk__target svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: #0b0d0e;
    stroke: rgba(0, 0, 0, 0.6);
    filter: blur(calc((1 - var(--k-t)) * 0.06cqw));
  }

  .sk__box {
    position: absolute;
    inset: -45% -25%;
    border: 1px dashed rgba(var(--red), calc(var(--track) * (1 - var(--lock) * 0.7 + var(--held) * 0.7)));
    opacity: var(--track);
  }

  .sk__box i {
    position: absolute;
    width: 22%;
    height: 34%;
    border: 0 solid rgb(var(--red));
    opacity: calc(var(--lock) * (1 - var(--held)));
  }

  .sk__box i:nth-child(1) {
    left: -2px;
    top: -2px;
    border-width: 2px 0 0 2px;
  }

  .sk__box i:nth-child(2) {
    right: -2px;
    top: -2px;
    border-width: 2px 2px 0 0;
  }

  .sk__box i:nth-child(3) {
    left: -2px;
    bottom: -2px;
    border-width: 0 0 2px 2px;
  }

  .sk__box i:nth-child(4) {
    right: -2px;
    bottom: -2px;
    border-width: 0 2px 2px 0;
  }

  .sk__tag {
    position: absolute;
    left: -1px;
    bottom: calc(100% + 0.4em);
    display: grid;
    padding: 0.2em 0.5em;
    background: rgba(var(--red), 0.85);
    font-weight: 500;
    font-size: 0.85em;
    white-space: nowrap;
    color: #fff;
  }

  .sk__tag > span {
    grid-area: 1 / 1;
  }

  .sk__tag-name {
    opacity: calc(1 - var(--held));
  }

  .sk__tag-held {
    opacity: var(--held);
  }

  /* A cloud bank passes over the target; the track holds through it. */
  .sk__cloud {
    position: absolute;
    top: 8%;
    left: calc(-60% + var(--cloud) * 170%);
    width: 60%;
    height: 70%;
    background:
      radial-gradient(closest-side at 30% 50%, rgba(205, 215, 220, 0.85), transparent),
      radial-gradient(closest-side at 60% 40%, rgba(220, 228, 232, 0.9), transparent),
      radial-gradient(closest-side at 75% 60%, rgba(200, 210, 215, 0.8), transparent);
    filter: blur(1.2cqw);
    opacity: min(1, var(--cloud) * 6, (1 - var(--cloud)) * 6);
  }

  .sk__reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6cqw;
    height: 6cqw;
    transform: translate(-50%, -50%);
    opacity: calc(1 - var(--hit));
    background:
      linear-gradient(rgba(225, 240, 230, 0.7), rgba(225, 240, 230, 0.7)) center / 1px 100% no-repeat,
      linear-gradient(rgba(225, 240, 230, 0.7), rgba(225, 240, 230, 0.7)) center / 100% 1px no-repeat;
    -webkit-mask: radial-gradient(circle, transparent 18%, #000 19%);
    mask: radial-gradient(circle, transparent 18%, #000 19%);
  }

  /* Radar coordinates the interceptor is flying to, until the camera finds the drone. */
  .sk__wp {
    position: absolute;
    left: 50%;
    top: 34%;
    display: grid;
    justify-items: center;
    gap: 0.6em;
    transform: translateX(-50%);
    text-transform: uppercase;
    color: rgb(150, 230, 255);
    opacity: min(clamp(0, (var(--p) - 0.03) * 25, 1), clamp(0, (0.2 - var(--p)) * 25, 1));
  }

  .sk__wp i {
    width: 1.6em;
    height: 1.6em;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
  }

  .sk__hud {
    position: absolute;
    display: grid;
    gap: 0.3em;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  .sk__hud--tl {
    left: 2.5%;
    top: 4%;
  }

  .sk__rec {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: rgb(var(--red));
  }

  .sk__rec i {
    width: 0.6em;
    height: 0.6em;
    border-radius: 999px;
    background: currentColor;
    animation: sk-blink 1.2s steps(2, jump-none) infinite;
  }

  .sk__badges {
    position: absolute;
    right: 2.5%;
    top: 4%;
    display: flex;
    gap: 0.4em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sk__badges li {
    padding: 0.25em 0.6em;
    border: 1px solid rgba(140, 255, 190, 0.5);
    background: rgba(0, 0, 0, 0.45);
    font-size: 0.85em;
    text-transform: uppercase;
    color: rgb(150, 255, 195);
  }

  .sk__telemetry {
    position: absolute;
    left: 2.5%;
    bottom: 5%;
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 0.3em 1.6em;
    margin: 0;
    padding: 0.6em 0.9em;
    background: rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
  }

  .sk__telemetry div {
    display: grid;
    gap: 0.15em;
  }

  .sk__telemetry dt {
    font-size: 0.75em;
    color: rgba(225, 240, 230, 0.6);
  }

  .sk__telemetry dd {
    margin: 0;
    font-size: 1.15em;
    font-variant-numeric: tabular-nums;
  }

  .sk__stages {
    position: absolute;
    right: 2.5%;
    bottom: 5%;
    display: flex;
    gap: 0.25em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sk__stages li {
    --now: min(clamp(0, (var(--p) - var(--s0)) * 30, 1), clamp(0, (var(--s1) - var(--p)) * 30, 1));
    --past: clamp(0, (var(--p) - var(--s0)) * 30, 1);
    padding: 0.35em 0.6em;
    border: 1px solid rgba(225, 240, 230, calc(0.15 + var(--past) * 0.3));
    background: rgba(var(--red), calc(var(--now) * 0.85));
    font-size: 0.85em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, calc(0.45 + var(--past) * 0.55));
  }

  .sk__flash {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 51% 44%, #fff, rgba(255, 210, 230, 0.6) 30%, transparent 70%);
    opacity: calc(var(--hit) * clamp(0, (0.93 - var(--p)) * 14, 1));
  }

  .sk__done {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    padding: 0.5em 1.1em;
    border: 1px solid rgba(var(--ok), 0.7);
    background: rgba(0, 0, 0, 0.6);
    font-size: 1.6em;
    text-transform: uppercase;
    color: rgb(var(--ok));
    transform: translate(-50%, -50%) scale(calc(0.9 + clamp(0, (var(--p) - 0.9) * 20, 1) * 0.1));
    opacity: clamp(0, (var(--p) - 0.9) * 20, 1);
  }

  .sk__operator {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-top: 1px solid rgba(var(--rgb-fg), 0.12);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .sk__op-label {
    color: rgba(var(--rgb-fg), 0.55);
  }

  .sk__op-ok {
    color: rgb(var(--ok));
  }

  .sk__abort {
    display: grid;
    margin-left: auto;
    padding: 0.35rem 0.8rem;
    border: 1px solid rgba(var(--red), calc(0.8 - var(--term) * 0.6));
    color: rgba(var(--red), calc(1 - var(--term) * 0.6));
  }

  .sk__abort > span {
    grid-area: 1 / 1;
    text-align: center;
  }

  .sk__abort-on {
    opacity: calc(1 - var(--term));
  }

  .sk__abort-off {
    opacity: var(--term);
    color: rgba(var(--rgb-fg), 0.5);
  }

  .sk__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .sk__step {
    --now: min(clamp(0, (var(--p) - var(--s0)) * 25, 1), clamp(0, (var(--s1) - var(--p)) * 25, 1));
    --done: clamp(0, (var(--p) - var(--s0)) * 25, 1);
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding-top: 0.55rem;
    font-size: 0.88rem;
    line-height: 1.3;
    color: rgba(var(--rgb-fg), calc(0.62 + var(--now) * 0.38));
  }

  .sk__step-n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(var(--rgb-accent), calc(0.6 + var(--done) * 0.4));
  }

  .sk__step i {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: rgba(var(--rgb-fg), 0.18);
  }

  .sk__step i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grad-brand, var(--color-accent));
    transform: scaleX(var(--done));
    transform-origin: left;
  }

  .sk__caption {
    margin-top: 0.6rem;
    text-align: right;
    color: rgba(var(--rgb-fg), 0.55);
  }

  @keyframes sk-scan {
    from {
      background-position: 0 100%;
    }
    to {
      background-position: 0 -100%;
    }
  }

  @keyframes sk-wobble {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0.4cqw -0.3cqw;
    }
  }

  @keyframes sk-blink {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.2;
    }
  }

  @media (max-width: 899px) {
    .sk__feed {
      font-size: 2.3cqw;
    }

    .sk__stages {
      display: none;
    }

    .sk__telemetry {
      right: 2.5%;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.3em 0.8em;
    }

    .sk__operator {
      gap: 0.6rem;
      padding: 0.6rem 0.75rem;
      font-size: 0.62rem;
      white-space: nowrap;
    }

    .sk__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sk__scan,
    .sk__target,
    .sk__rec i {
      animation: none;
    }
  }
</style>
