---
import type { Dictionary } from '../../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section class="ops" id="capabilities">
  <div class="ops-hero ops-hero--compact ops-hero--plain">
    <div class="ops-veil" aria-hidden="true"></div>
    <div class="container-axion ops-hero__inner">
      <div class="ops-meta reveal">
        <span class="ops-meta__live"></span>
        <span>{dict.capabilities.label}</span>
        <span class="ops-meta__sep" aria-hidden="true"></span>
        <span>ENGINEERING</span>
      </div>

      <div class="ops-copy ops-copy--wide reveal" style="transition-delay: 80ms">
        <div class="ops-reticle" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
        </div>
        <h2 class="ops-title">{dict.capabilities.title}</h2>
      </div>
    </div>
  </div>

  <div class="ops-strip">
    <div class="container-axion ops-strip__grid ops-strip__grid--3">
      {dict.capabilities.items.map((item, i) => (
        <article class="ops-item reveal" style={`transition-delay: ${100 + i * 50}ms`}>
          <span class="ops-item__idx">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
