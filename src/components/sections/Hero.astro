---
import type { Dictionary, Locale } from '../../i18n/types';
import { localizePath } from '../../lib/paths';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
---

<section id="hero" class="hero" data-hero data-locale={locale}>
  <div class="hero-media" data-hero-media aria-hidden="true">
    <video
      class="hero-video"
      data-hero-video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/defence-security.jpg"
    >
      <source src="/media/eas.mp4" type="video/mp4" />
    </video>
    <div class="hero-media__fallback" style="background-image: url('/images/defence-security.jpg')"></div>
  </div>

  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-noise" aria-hidden="true"></div>

  <div class="container-axion hero-stage">
    <div class="hero-top hero-line" style="--d: 0ms">
      <div class="hero-chip">
        <span class="hero-chip__pip"></span>
        <span>{dict.hero.label}</span>
      </div>
      <div class="hero-chip hero-chip--ghost">
        <span class="hero-chip__code">LIVE OPS</span>
      </div>
    </div>

    <div class="hero-core">
      <p class="hero-index hero-line" style="--d: 40ms" aria-hidden="true">01</p>

      <div class="hero-copy">
        <div class="hero-lock" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>

        <h1 class="hero-line hero-title" style="--d: 90ms">
          {dict.hero.titleLines.map((line) => (
            <span class="hero-title__line">{line}</span>
          ))}
        </h1>

        <div class="hero-line hero-split" style="--d: 180ms">
          <p class="hero-subtitle">{dict.hero.subtitle}</p>
          <div class="hero-actions">
            <a href={localizePath('contact', locale)} class="hero-btn hero-btn--primary">
              {dict.hero.primaryCta}
            </a>
            <a href={localizePath('about', locale)} class="hero-btn hero-btn--ghost">
              {dict.hero.secondaryCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <a href="#company" class="hero-scroll" data-hero-scroll aria-label="Scroll">
    <span>scroll</span>
    <i></i>
  </a>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]');
    const media = hero.querySelector<HTMLElement>('[data-hero-media]');
    const scrollCue = hero.querySelector<HTMLElement>('[data-hero-scroll]');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    requestAnimationFrame(() => hero.classList.add('is-ready'));

    if (video) {
      if (prefersReduced) {
        video.pause();
        video.removeAttribute('autoplay');
        hero.classList.add('is-static');
      } else {
        const tryPlay = () => {
          video.play().catch(() => hero.classList.add('is-static'));
        };
        if (video.readyState >= 2) {
          hero.classList.add('is-video-ready');
          tryPlay();
        } else {
          video.addEventListener(
            'loadeddata',
            () => {
              hero.classList.add('is-video-ready');
              tryPlay();
            },
            { once: true },
          );
        }
      }
    }

    const onScroll = () => {
      // IntroStage owns scroll-linked motion when hero is pinned
      if (hero.closest('[data-intro-stage]')) return;
      const y = window.scrollY;
      if (scrollCue) scrollCue.style.opacity = y > 90 ? '0' : '1';
      if (media && !prefersReduced) {
        const progress = Math.min(y / window.innerHeight, 1);
        media.style.transform = `scale(${1 + progress * 0.05}) translate3d(0, ${progress * 36}px, 0)`;
        media.style.filter = `brightness(${1 - progress * 0.22})`;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    if (!prefersReduced && video) {
      hero.addEventListener('pointermove', (e: PointerEvent) => {
        const rect = hero.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        video.style.transform = `scale(1.05) translate3d(${x * -10}px, ${y * -6}px, 0)`;
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-video,
  .hero-media__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-video {
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1),
      transform 8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero.is-video-ready .hero-video {
    opacity: 1;
    transform: scale(1.02);
  }

  .hero-media__fallback {
    background-size: cover;
    background-position: center;
    z-index: -1;
  }

  .hero.is-static .hero-video {
    display: none;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(105deg, rgba(11, 18, 32, 0.9) 0%, rgba(11, 18, 32, 0.55) 46%, rgba(11, 18, 32, 0.18) 70%, rgba(11, 18, 32, 0.5) 100%),
      linear-gradient(180deg, rgba(11, 18, 32, 0.45) 0%, transparent 32%, transparent 60%, rgba(11, 18, 32, 0.92) 100%);
  }

  .hero-noise {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .hero-stage {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: 7rem;
    padding-bottom: clamp(4.5rem, 11vh, 7.5rem);
  }

  .hero-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: clamp(1.75rem, 4vh, 2.75rem);
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.85rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(21, 112, 239, 0.45);
    background: rgba(21, 112, 239, 0.1);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-chip--ghost {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(11, 18, 32, 0.35);
    color: rgba(213, 215, 218, 0.78);
  }

  .hero-chip__pip {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--color-accent);
    animation: livePulse 2s ease-out infinite;
  }

  .hero-chip__code {
    color: #fff;
  }

  .hero-core {
    position: relative;
    max-width: 54rem;
  }

  .hero-index {
    position: absolute;
    left: -0.1rem;
    top: -1.6rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 16vw, 10rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.05);
    pointer-events: none;
    user-select: none;
  }

  .hero-copy {
    position: relative;
    padding: 0.35rem 0 0.2rem;
  }

  .hero-lock {
    position: absolute;
    inset: -0.55rem -0.7rem;
    pointer-events: none;
  }

  .hero-lock span {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 1.5px solid rgba(21, 112, 239, 0.7);
  }

  .hero-lock span:nth-child(1) {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }
  .hero-lock span:nth-child(2) {
    top: 0;
    right: 0;
    border-left: 0;
    border-bottom: 0;
  }
  .hero-lock span:nth-child(3) {
    bottom: 0;
    left: 0;
    border-right: 0;
    border-top: 0;
  }
  .hero-lock span:nth-child(4) {
    right: 0;
    bottom: 0;
    border-left: 0;
    border-top: 0;
  }

  .hero-title {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.08em;
    max-width: min(100%, 38rem);
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.4vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.12;
    text-transform: none;
    color: #fff;
  }

  .hero-title__line {
    display: block;
  }

  /* Cyrillic needs a bit more room and softer tracking */
  .hero[data-locale='ru'] .hero-title {
    max-width: min(100%, 42rem);
    font-size: clamp(2rem, 4.8vw, 3.55rem);
    letter-spacing: 0.005em;
    line-height: 1.16;
    font-weight: 600;
  }

  .hero[data-locale='uz'] .hero-title {
    max-width: min(100%, 36rem);
  }

  .hero-split {
    display: grid;
    gap: 1.35rem;
    margin-top: 1.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 900px) {
    .hero-split {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: end;
      gap: 2.5rem;
    }
  }

  .hero-subtitle {
    margin: 0;
    max-width: 38rem;
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.25vw, 1.05rem);
    line-height: 1.7;
    color: rgba(213, 215, 218, 0.9);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  @media (min-width: 900px) {
    .hero-actions {
      justify-content: flex-end;
    }
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      transform 0.3s ease,
      filter 0.3s ease,
      background 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .hero-btn:hover {
    transform: translateY(-2px);
  }

  .hero-btn--primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: 0 10px 28px -12px rgba(21, 112, 239, 0.85);
  }

  .hero-btn--primary:hover {
    filter: brightness(1.08);
  }

  .hero-btn--ghost {
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-btn--ghost:hover {
    border-color: rgba(21, 112, 239, 0.7);
    background: rgba(21, 112, 239, 0.12);
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    z-index: 4;
    display: none;
    transform: translateX(-50%);
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    transition: opacity 0.45s ease;
  }

  @media (min-width: 768px) {
    .hero-scroll {
      display: flex;
    }
  }

  .hero-scroll span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-scroll i {
    position: relative;
    width: 1px;
    height: 2.2rem;
    overflow: hidden;
    background: rgba(21, 112, 239, 0.2);
  }

  .hero-scroll i::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 45%;
    background: var(--color-accent);
    animation: scrollPulse 1.6s ease-in-out infinite;
  }

  .hero-line {
    opacity: 0;
    transform: translateY(20px);
  }

  .hero.is-ready .hero-line {
    animation: heroIn 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes heroIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes livePulse {
    0% {
      box-shadow: 0 0 0 0 rgba(21, 112, 239, 0.5);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(21, 112, 239, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(21, 112, 239, 0);
    }
  }

  @keyframes scrollPulse {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(220%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line {
      opacity: 1;
      transform: none;
      animation: none !important;
    }

    .hero-video,
    .hero-chip__pip,
    .hero-scroll i::after {
      animation: none !important;
      transition: none !important;
    }

    .hero-btn:hover {
      transform: none;
    }
  }
</style>
