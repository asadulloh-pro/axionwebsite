---
import Hero from './Hero.astro';
import Company from './Company.astro';
import type { Dictionary, Locale } from '../../i18n/types';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
---

<div class="intro-stage" data-intro-stage>
  <div class="intro-stage__pin" data-intro-pin>
    <div class="intro-panel intro-panel--hero" data-intro-panel="hero">
      <Hero dict={dict} locale={locale} />
    </div>
    <div class="intro-panel intro-panel--company" data-intro-panel="company">
      <Company dict={dict} />
    </div>
  </div>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('[data-intro-stage]');
  if (stage) {
    const heroPanel = stage.querySelector<HTMLElement>('[data-intro-panel="hero"]');
    const companyPanel = stage.querySelector<HTMLElement>('[data-intro-panel="company"]');
    const hero = stage.querySelector<HTMLElement>('[data-hero]');
    const heroMedia = stage.querySelector<HTMLElement>('[data-hero-media]');
    const scrollCue = stage.querySelector<HTMLElement>('[data-hero-scroll]');
    const companyReveals = companyPanel?.querySelectorAll('.reveal') ?? [];
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const clamp = (n: number, min = 0, max = 1) => Math.min(max, Math.max(min, n));
    const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);

    const setProgress = (raw: number) => {
      const p = clamp(raw);
      stage.style.setProperty('--intro-progress', String(p));

      // Hold hero, then morph, then hold company
      const morph = easeInOut(clamp((p - 0.08) / 0.72));

      if (heroPanel) {
        heroPanel.style.opacity = String(1 - morph);
        heroPanel.style.transform = `scale(${1 - morph * 0.04}) translate3d(0, ${morph * -28}px, 0)`;
        heroPanel.style.filter = `blur(${morph * 6}px)`;
        heroPanel.style.pointerEvents = morph > 0.55 ? 'none' : 'auto';
      }

      if (companyPanel) {
        companyPanel.style.opacity = String(morph);
        companyPanel.style.transform = `scale(${1.04 - morph * 0.04}) translate3d(0, ${(1 - morph) * 36}px, 0)`;
        companyPanel.style.filter = `blur(${(1 - morph) * 8}px)`;
        companyPanel.style.pointerEvents = morph > 0.45 ? 'auto' : 'none';
      }

      if (heroMedia && !prefersReduced) {
        heroMedia.style.transform = `scale(${1 + morph * 0.08})`;
        heroMedia.style.filter = `brightness(${1 - morph * 0.35})`;
      }

      if (scrollCue) {
        scrollCue.style.opacity = p > 0.04 ? '0' : '1';
      }

      if (morph > 0.2) {
        companyReveals.forEach((el) => el.classList.add('is-visible'));
      }

      stage.classList.toggle('is-on-company', morph > 0.55);
      hero?.classList.toggle('is-dimmed', morph > 0.15);
    };

    const update = () => {
      if (prefersReduced || stage.classList.contains('is-static')) {
        setProgress(0);
        return;
      }
      const rect = stage.getBoundingClientRect();
      const total = stage.offsetHeight - window.innerHeight;
      const scrolled = -rect.top;
      setProgress(total > 0 ? scrolled / total : 0);
    };

    if (prefersReduced) {
      stage.classList.add('is-static');
      if (heroPanel) {
        heroPanel.style.opacity = '1';
        heroPanel.style.transform = 'none';
        heroPanel.style.filter = 'none';
        heroPanel.style.pointerEvents = 'auto';
      }
      if (companyPanel) {
        companyPanel.style.opacity = '1';
        companyPanel.style.transform = 'none';
        companyPanel.style.filter = 'none';
        companyPanel.style.pointerEvents = 'auto';
      }
      companyReveals.forEach((el) => el.classList.add('is-visible'));
    } else {
      setProgress(0);
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    // Scroll cue / #company deep links → finish the morph
    const scrollToCompany = (e?: Event) => {
      if (prefersReduced || stage.classList.contains('is-static')) return;
      e?.preventDefault();
      const top = stage.offsetTop + stage.offsetHeight - window.innerHeight;
      window.scrollTo({ top, behavior: 'smooth' });
    };

    scrollCue?.addEventListener('click', scrollToCompany);

    if (location.hash === '#company') {
      requestAnimationFrame(() => scrollToCompany());
    }

    document.querySelectorAll('a[href="#company"]').forEach((link) => {
      if (link === scrollCue) return;
      link.addEventListener('click', scrollToCompany);
    });
  }
</script>

<style is:global>
  .intro-stage {
    --intro-progress: 0;
    position: relative;
    height: 240vh;
  }

  .intro-stage__pin {
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    background: #0b1220;
  }

  .intro-panel {
    position: absolute;
    inset: 0;
    will-change: opacity, transform, filter;
  }

  .intro-panel--hero {
    z-index: 1;
  }

  .intro-panel--company {
    z-index: 2;
    opacity: 0;
    pointer-events: none;
  }

  .intro-stage .hero,
  .intro-stage .ops,
  .intro-stage .ops-hero {
    height: 100%;
    min-height: 100%;
    border-top: 0;
  }

  .intro-stage .hero {
    min-height: 100%;
  }

  .intro-stage .ops-hero--tall {
    min-height: 100%;
  }

  .intro-stage .ops-hero__inner {
    min-height: 100%;
    padding-block: clamp(5rem, 12vh, 7.5rem);
  }

  .intro-stage .hero-stage {
    padding-bottom: clamp(4.5rem, 11vh, 7.5rem);
  }

  /* Reduced motion / fallback: normal stacked scroll */
  .intro-stage.is-static {
    height: auto;
  }

  .intro-stage.is-static .intro-stage__pin {
    position: relative;
    height: auto;
    overflow: visible;
  }

  .intro-stage.is-static .intro-panel {
    position: relative;
    inset: auto;
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
    pointer-events: auto !important;
  }

  .intro-stage.is-static .hero,
  .intro-stage.is-static .ops,
  .intro-stage.is-static .ops-hero {
    height: auto;
    min-height: 100dvh;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-stage {
      height: auto;
    }

    .intro-stage .intro-stage__pin {
      position: relative;
      height: auto;
      overflow: visible;
    }

    .intro-stage .intro-panel {
      position: relative;
      inset: auto;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      pointer-events: auto !important;
    }

    .intro-stage .hero,
    .intro-stage .ops,
    .intro-stage .ops-hero {
      height: auto;
      min-height: 100dvh;
    }
  }
</style>
