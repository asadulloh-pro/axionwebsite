---
import type { Dictionary, Locale } from '../../i18n/types';
import { localizePath } from '../../lib/paths';

interface Props {
  dict: Dictionary;
  locale: Locale;
  detailed?: boolean;
  showHeader?: boolean;
}

const { dict, locale, detailed = false, showHeader = true } = Astro.props;
---

<section class="ops" id="solutions">
  {showHeader && (
    <div class="ops-hero ops-hero--compact ops-hero--plain">
      <div class="ops-veil" aria-hidden="true"></div>
      <div class="container-axion ops-hero__inner">
        <div class="ops-meta reveal">
          <span class="ops-meta__live"></span>
          <span>{dict.solutions.label}</span>
          <span class="ops-meta__sep" aria-hidden="true"></span>
          <span>DIRECTIONS</span>
        </div>

        <div class="ops-copy ops-copy--wide reveal" style="transition-delay: 80ms">
          <div class="ops-reticle" aria-hidden="true">
            <i></i><i></i><i></i><i></i>
          </div>
          <h2 class="ops-title">{dict.solutions.title}</h2>
          <p class="ops-body">{dict.solutions.subtitle}</p>
        </div>
      </div>
    </div>
  )}

  <div class="ops-strip sol">
    <div class="container-axion ops-strip__grid ops-strip__grid--2 sol__grid">
      {dict.solutions.items.map((item, i) => {
        const href = `${localizePath('solutions', locale)}#${item.id}`;
        return (
          <article
            class="sol__card reveal"
            id={detailed ? item.id : undefined}
            style={`transition-delay: ${80 + i * 70}ms`}
          >
            <div class="sol__media" aria-hidden="true">
              <img
                src={item.image}
                alt=""
                width="900"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="sol__veil" aria-hidden="true"></div>

            <div class="sol__inner">
              <div class="ops-meta">
                <span class="ops-meta__live"></span>
                <span>{item.index}</span>
                <span class="ops-meta__sep" aria-hidden="true"></span>
                <span>{item.id}</span>
              </div>

              <div class="sol__copy">
                <div class="ops-reticle" aria-hidden="true">
                  <i></i><i></i><i></i><i></i>
                </div>
                <h3 class="ops-title sol__title">{item.title}</h3>
                <p class="ops-body">{item.description}</p>

                {detailed && (
                  <ul class="sol__points">
                    {item.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}

                {!detailed && (
                  <div class="ops-actions">
                    <a href={href} class="ops-btn ops-btn--ghost">
                      {dict.solutions.learnMore}
                    </a>
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .sol__grid {
    gap: 0.85rem;
    padding: 1.15rem 0 1.6rem;
  }

  @media (min-width: 768px) {
    .sol__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .sol__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-width: 0;
    min-height: clamp(24rem, 48vh, 30rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0b1220;
  }

  @media (min-width: 768px) {
    .sol__card {
      border: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
    }

    .sol__card:last-child {
      border-right: 0;
    }
  }

  .sol__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .sol__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s var(--ease-out-expo);
  }

  .sol__card:hover .sol__media img {
    transform: scale(1.04);
  }

  .sol__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(8, 12, 22, 0.15) 0%,
        rgba(8, 12, 22, 0.5) 45%,
        rgba(8, 12, 22, 0.94) 100%
      ),
      linear-gradient(100deg, rgba(8, 12, 22, 0.55) 0%, transparent 50%);
  }

  .sol__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    height: 100%;
    min-height: inherit;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .sol__copy {
    position: relative;
    max-width: 30rem;
  }

  .sol__title {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
  }

  .sol__points {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .sol__points li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgba(213, 215, 218, 0.9);
  }

  .sol__points li::before {
    content: '';
    margin-top: 0.45rem;
    width: 0.35rem;
    height: 0.35rem;
    flex-shrink: 0;
    background: var(--color-accent);
  }

  .sol__card[id] {
    scroll-margin-top: 6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .sol__media img {
      transition: none;
    }

    .sol__card:hover .sol__media img {
      transform: none;
    }
  }
</style>
