---
import type { Dictionary } from '../../i18n/types';

interface Props {
  dict: Dictionary;
  showHeader?: boolean;
}

const { dict, showHeader = true } = Astro.props;
---

<section class="ops" id="technologies">
  {showHeader && (
    <div class="ops-hero ops-hero--compact ops-hero--plain">
      <div class="ops-veil" aria-hidden="true"></div>
      <div class="container-axion ops-hero__inner">
        <div class="ops-meta reveal">
          <span class="ops-meta__live"></span>
          <span>{dict.technologies.label}</span>
          <span class="ops-meta__sep" aria-hidden="true"></span>
          <span>STACK</span>
        </div>

        <div class="ops-copy ops-copy--wide reveal" style="transition-delay: 80ms">
          <div class="ops-reticle" aria-hidden="true">
            <i></i><i></i><i></i><i></i>
          </div>
          <h2 class="ops-title">{dict.technologies.title}</h2>
          <p class="ops-body">{dict.technologies.subtitle}</p>
        </div>
      </div>
    </div>
  )}

  <div class="ops-strip">
    <div class="container-axion ops-strip__grid ops-strip__grid--3">
      {dict.technologies.items.map((item, i) => (
        <article class="ops-item reveal" style={`transition-delay: ${100 + i * 45}ms`}>
          <span class="ops-item__idx">{item.index.replace(/[\[\]]/g, '')}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
