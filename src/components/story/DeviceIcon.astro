---
import type { DeviceId } from '../../i18n/types';

interface Props {
  id: DeviceId;
  size?: number;
  class?: string;
}

const { id, size = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {id === 'radar' && (
    <>
      <path d="M12 21a9 9 0 1 1 9-9" />
      <path d="M12 16.5a4.5 4.5 0 1 1 4.5-4.5" />
      <path d="M12 12l6.4-6.4" />
      <circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none" />
      <circle cx="17.6" cy="8.8" r="0.9" fill="currentColor" stroke="none" />
    </>
  )}
  {id === 'lidar' && (
    <>
      <rect x="2.5" y="9.5" width="5.5" height="5" rx="1" />
      <path d="M8 12l12.5-6.5M8 12h12.5M8 12l12.5 6.5" stroke-dasharray="1.6 1.8" />
      <circle cx="20.5" cy="5.5" r="0.9" fill="currentColor" stroke="none" />
      <circle cx="20.5" cy="12" r="0.9" fill="currentColor" stroke="none" />
      <circle cx="20.5" cy="18.5" r="0.9" fill="currentColor" stroke="none" />
    </>
  )}
  {id === 'camera' && (
    <>
      <rect x="2.5" y="7" width="13" height="10" rx="1.5" />
      <path d="M15.5 10.5l6-3v9l-6-3" />
      <circle cx="9" cy="12" r="2.6" />
      <circle cx="9" cy="12" r="0.6" fill="currentColor" stroke="none" />
    </>
  )}
  {id === 'jammer' && (
    <>
      <path d="M12 10v11M8.5 21h7" />
      <circle cx="12" cy="8" r="1.4" />
      <path d="M8.7 4.7a4.7 4.7 0 0 0 0 6.6M15.3 4.7a4.7 4.7 0 0 1 0 6.6" />
      <path d="M5.8 1.9a8.7 8.7 0 0 0 0 12.2M18.2 1.9a8.7 8.7 0 0 1 0 12.2" />
    </>
  )}
  {id === 'uav' && (
    <>
      <rect x="9.5" y="9.5" width="5" height="5" rx="1" />
      <path d="M9.5 9.5L6.6 6.6M14.5 9.5l2.9-2.9M9.5 14.5l-2.9 2.9M14.5 14.5l2.9 2.9" />
      <circle cx="5" cy="5" r="2.6" />
      <circle cx="19" cy="5" r="2.6" />
      <circle cx="5" cy="19" r="2.6" />
      <circle cx="19" cy="19" r="2.6" />
    </>
  )}
  {id === 'interceptor' && (
    <>
      <path d="M17.5 4.5c1.2-.3 2.3.8 2 2L12 14l-2-2z" />
      <path d="M10 12l-3.5-.5-2 2 3.5 1M12 14l.5 3.5-2 2-1-3.5" />
      <path d="M3.5 20.5l3-3" stroke-dasharray="1.2 1.6" />
    </>
  )}
</svg>
