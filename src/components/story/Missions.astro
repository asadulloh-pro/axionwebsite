---
import type { Dictionary, Locale } from '../../i18n/types';
import { localizePath } from '../../lib/paths';
import ChapterIntro from './ChapterIntro.astro';
import MissionVisual from './MissionVisual.astro';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const t = dict.story.missions;
---

<section class="chapter missions" data-chapter data-rail={dict.story.rail[6]} aria-labelledby="missions-title">
  <div class="container-axion section-pad">
    <div class="missions__head reveal">
      <ChapterIntro id="missions-title" index={6} label={t.label} title={t.title} />
    </div>

    <div class="missions__grid">
      {t.items.map((item, i) => (
        <a
          href={`${localizePath('solutions', locale)}#${item.id}`}
          class="missions__card panel reveal"
          style={`transition-delay: ${i * 120}ms`}
        >
          <div class="missions__visual">
            <MissionVisual id={item.id} />
          </div>

          <div class="missions__content">
            <span class="hud missions__idx">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="headline headline--sm">{item.title}</h3>
            <p class="missions__body">{item.body}</p>
            <ul class="missions__tags">
              {item.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <span class="link-arrow">
              {t.link}
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .missions__head {
    max-width: 48rem;
  }

  .missions__grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  @media (min-width: 900px) {
    .missions__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .missions__card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: rgba(var(--rgb-bg), 0.6);
    transition: border-color 0.4s ease;
  }

  .missions__card:hover {
    border-color: rgba(var(--rgb-fg), 0.28);
  }

  .missions__visual {
    position: relative;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--color-border);
    background: radial-gradient(ellipse 70% 80% at 50% 100%, rgba(var(--rgb-fg), 0.04), transparent 70%);
    opacity: 0.85;
    transition: opacity 0.4s ease;
  }

  .missions__card:hover .missions__visual {
    opacity: 1;
  }

  .missions__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .missions__idx {
    color: var(--color-fg-dim);
  }

  .missions__body {
    color: var(--color-fg-muted);
    line-height: 1.6;
  }

  .missions__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  .missions__tags li {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
</style>
