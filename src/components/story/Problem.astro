---
import type { Dictionary, Locale } from '../../i18n/types';
import { localizePath } from '../../lib/paths';
import ChapterIntro from './ChapterIntro.astro';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const t = dict.story.problem;
---

<section
  id="problem"
  class="chapter problem"
  data-chapter
  data-pin
  data-site
  data-length="2.2"
  data-rail={dict.story.rail[1]}
  aria-labelledby="problem-title"
>
  <div class="container-axion chapter__stage">
    <div class="chapter__grid">
      <div class="chapter__copy">
        <ChapterIntro id="problem-title" index={1} label={t.label} title={t.title} body={t.body} />
        <dl class="problem__lines">
          {t.lines.map((line) => (
            <div class="problem__line">
              <dt>{line.name}</dt>
              <dd>{line.text}</dd>
            </div>
          ))}
        </dl>
        <a href={localizePath('projects/c2-c4', locale)} class="btn btn--primary problem__cta">
          {t.cta}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="problem__scene" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .problem__scene {
    min-height: 40svh;
  }

  @media (min-width: 900px) {
    .problem__scene {
      min-height: 1px;
    }
  }

  .problem__lines {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .problem__line {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .problem__line dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-soft);
  }

  .problem__line dd {
    margin: 0;
    color: var(--color-fg-muted);
    line-height: 1.55;
  }

  .problem__cta {
    align-self: flex-start;
  }
</style>
