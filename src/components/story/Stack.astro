---
import type { Dictionary, Locale } from '../../i18n/types';
import { localizePath } from '../../lib/paths';
import ChapterIntro from './ChapterIntro.astro';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const t = dict.story.stack;
---

<section class="chapter stack" data-chapter data-rail={dict.story.rail[7]} aria-labelledby="stack-title">
  <div class="container-axion section-pad">
    <div class="stack__layout">
      <div class="stack__head reveal">
        <ChapterIntro id="stack-title" index={7} label={t.label} title={t.title}>
          <a href={localizePath('technologies', locale)} class="link-arrow">
            {t.link}
            <span aria-hidden="true">→</span>
          </a>
        </ChapterIntro>
      </div>

      <ol class="row-list stack__list">
        {t.items.map((item, i) => (
          <li class="row stack__row reveal" style={`transition-delay: ${i * 60}ms`}>
            <span class="row__idx">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="row__title">{item.title}</h3>
            <p class="row__body">{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .stack__layout {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 1100px) {
    .stack__layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }

    .stack__head {
      position: sticky;
      top: 7rem;
    }

    .stack__row {
      grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }

  .stack__row {
    position: relative;
    transition: background 0.3s ease;
  }

  .stack__row::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--grad-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .stack__row:hover::after {
    transform: scaleX(1);
  }
</style>
