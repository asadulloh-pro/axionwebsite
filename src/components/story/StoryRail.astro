---
interface Props {
  first: string;
  total: number;
}

const { first, total } = Astro.props;
---

<div class="rail" data-story-rail aria-hidden="true">
  <span class="rail__index" data-rail-index>01 / {String(total).padStart(2, '0')}</span>
  <span class="rail__bar" data-rail-bar><i></i></span>
  <span class="rail__label" data-rail-label>{first}</span>
</div>

<style>
  .rail {
    --rail-p: 0;
    position: fixed;
    left: clamp(1.25rem, 4vw, 3rem);
    bottom: 1.5rem;
    z-index: 40;
    display: none;
    align-items: center;
    gap: 0.9rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: rgba(var(--rgb-bg), 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  @media (min-width: 900px) {
    .rail {
      display: flex;
    }
  }

  .rail:global(.is-visible) {
    opacity: 1;
  }

  .rail__index {
    color: var(--color-fg);
  }

  .rail__bar {
    position: relative;
    width: 4.5rem;
    height: 1px;
    background: var(--color-border-strong);
  }

  .rail__bar i {
    position: absolute;
    inset: 0;
    background: var(--grad-brand-text);
    transform: scaleX(var(--rail-p));
    transform-origin: left;
  }
</style>
