---
import Layout from '../layouts/Layout.astro';
import { getDictionary, getLocaleFromUrl, type Locale } from '../i18n';
import { localizePath } from '../lib/paths';

const locale: Locale = getLocaleFromUrl(Astro.url);
const dict = getDictionary(locale);
---

<Layout
  locale={locale}
  title={`404 — ${dict.meta.siteName}`}
  description={dict.notFound.body}
  canonicalPath={localizePath('', locale)}
>
  <section class="min-h-[80dvh] flex items-center pt-24">
    <div class="container-axion text-center max-w-xl mx-auto">
      <p class="font-mono text-accent text-sm tracking-widest mb-4">404</p>
      <h1 class="text-3xl md:text-5xl font-semibold mb-4">{dict.notFound.title}</h1>
      <p class="text-fg-muted mb-8">{dict.notFound.body}</p>
      <a
        href={localizePath('', locale)}
        class="inline-flex items-center rounded-full bg-accent px-6 py-3 text-sm font-medium text-white transition hover:brightness-110"
      >
        {dict.notFound.cta}
      </a>
    </div>
  </section>
</Layout>
