---
import Layout from '../layouts/Layout.astro';
import { getDictionary, getLocaleFromUrl, type Locale } from '../i18n';
import { localizePath } from '../lib/paths';

const locale: Locale = getLocaleFromUrl(Astro.url);
const dict = getDictionary(locale);
---

<Layout
  locale={locale}
  title={`404 — ${dict.meta.siteName}`}
  description={dict.notFound.body}
  canonicalPath={localizePath('', locale)}
>
  <section class="page-hero not-found">
    <div class="container-axion not-found__inner">
      <p class="kicker">
        <span class="kicker__idx">404</span>
        <span class="kicker__rule" aria-hidden="true"></span>
        <span>{dict.meta.siteName}</span>
      </p>
      <h1 class="headline headline--md" data-split="load">{dict.notFound.title}</h1>
      <p class="lede">{dict.notFound.body}</p>
      <a href={localizePath('', locale)} class="btn btn--primary">{dict.notFound.cta}</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: 80dvh;
    border-bottom: 0;
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
</style>
